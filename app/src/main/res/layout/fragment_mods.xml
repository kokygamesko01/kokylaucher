<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:spacing="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mods"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Install Fabric, Forge, or Quilt mods for your instances. Mod files (.jar) go into each instance's mods/ directory."
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_install_mod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Install Mod" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Coming soon: Modrinth/CurseForge integration, modpack support, and automatic dependency resolution."
            android:textSize="12sp"
            android:textColor="#FF64748B" />

    </LinearLayout>
</ScrollView>
