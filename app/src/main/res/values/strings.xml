    <!-- About -->
    <string name="about_title">About Kokylaucher</string>
    <string name="about_description">Kokylaucher — a Minecraft: Java Edition launcher manager for Android.\n\nDownloads versions, libraries, assets, mods and resource packs into isolated instances and assembles the Java launch command.\n\nImportant: Minecraft: Java Edition native libraries (LWJGL/OpenAL) are built for desktop (Windows/Linux/macOS x86/x64), and Android uses ART rather than a standard JVM. Running the game on Android additionally requires a JVM port plus Android-native LWJGL (the approach used by the open-source PojavLauncher). This app manages instances and assembles the launch command; actually executing the game requires that JVM/LWJGL port, which is documented in README.md.</string>
    <string name="about_version">Version: %s</string>
    <string name="about_package">Package: com.mclauncher.android</string>

